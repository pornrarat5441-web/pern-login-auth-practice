<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - BookReview</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-slate-50 text-slate-800 flex flex-col">

  <!-- Navbar -->
  <%- include('../partials/navbar', { user }) %>

  <!-- Main Content -->
  <main class="flex-grow flex items-center justify-center px-4 py-12">

    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 w-full max-w-md">
      
      <!-- Header -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 text-2xl mb-3">
          ✨
        </div>
        <h2 class="text-2xl font-bold text-slate-900">
          สร้างบัญชีผู้ใช้งาน
        </h2>
        <p class="text-sm text-slate-500 mt-1">
          สมัครสมาชิกเพื่อเริ่มบันทึกรายการหนังสือและรีวิวเล่มโปรดของคุณ
        </p>
      </div>

      <!-- Form -->
      <form id="registerForm" class="space-y-5">

        <!-- กล่องแจ้งเตือน Error -->
        <div id="errorMessage" class="hidden p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-600 text-sm"></div>

        <div>
          <label for="name" class="block text-sm font-medium text-slate-700 mb-1.5">
            ชื่อที่แสดง (Name)
          </label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="กรอกชื่อของคุณ"
            required
            class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition"
          >
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">
            อีเมล (Email)
          </label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="name@example.com"
            required
            class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition"
          >
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-slate-700 mb-1.5">
            รหัสผ่าน (Password)
          </label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="ตั้งรหัสผ่านของคุณ"
            required
            class="w-full px-4 py-2.5 text-sm bg-white border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition"
          >
        </div>

        <button
          type="submit"
          id="registerButton"
          class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 disabled:bg-indigo-400 text-white text-sm font-semibold rounded-xl shadow-sm transition cursor-pointer"
        >
          สมัครสมาชิก
        </button>

      </form>

      <!-- ลิงก์ไปหน้าเข้าสู่ระบบ -->
      <p class="text-center mt-6 pt-6 border-t border-slate-100 text-sm text-slate-600">
        มีบัญชีผู้ใช้งานอยู่แล้ว?
        <a href="/login" class="text-indigo-600 hover:text-indigo-700 font-semibold hover:underline">
          เข้าสู่ระบบ
        </a>
      </p>

    </div>

  </main>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <script>
    const registerForm = document.getElementById('registerForm');
    const errorMessage = document.getElementById('errorMessage');
    const registerButton = document.getElementById('registerButton');

    registerForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      errorMessage.classList.add('hidden');
      registerButton.disabled = true;
      registerButton.textContent = 'กำลังสร้างบัญชี...';

      const formData = {
        name: registerForm.name.value.trim(),
        email: registerForm.email.value.trim(),
        password: registerForm.password.value
      };

      try {
        const response = await fetch('/api/auth/register', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          credentials: 'same-origin',
          body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'การสมัครสมาชิกล้มเหลว');
        }

        window.location.href = '/';

      } catch (error) {
        errorMessage.textContent = error.message;
        errorMessage.classList.remove('hidden');

      } finally {
        registerButton.disabled = false;
        registerButton.textContent = 'สมัครสมาชิก';
      }
    });
  </script>

</body>
</html>