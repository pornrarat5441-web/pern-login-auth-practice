<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>หนังสือที่คุณรีวิวแล้ว - BookReview</title>
  <link rel="stylesheet" href="/css/output.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- Navbar -->
  <nav class="bg-white shadow-sm border-b border-slate-200 sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
      <a href="/" class="text-xl font-bold text-indigo-600">BookReview</a>
      <div class="space-x-6 text-sm font-medium text-slate-600">
        <a href="/" class="hover:text-indigo-600">Home</a>
        <a href="/your-list" class="hover:text-indigo-600">Your List</a>
        <a href="/rated-books" class="text-indigo-600 font-semibold">Rated Books</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="max-w-5xl mx-auto px-4 py-8 flex-grow w-full">

    <!-- Header & สรุปสถิติการรีวิว -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900">หนังสือที่คุณให้คะแนนแล้ว</h1>
        <p class="text-sm text-slate-500 mt-1">ประวัติการให้คะแนนและรีวิวหนังสือทั้งหมดของคุณ</p>
      </div>

      <% if (ratedBooks.length > 0) { %>
        <% 
          const totalRated = ratedBooks.length;
          const avgGiven = (ratedBooks.reduce((sum, item) => sum + item.rating, 0) / totalRated).toFixed(1);
        %>
        <div class="flex items-center gap-4 bg-white px-5 py-3 rounded-2xl border border-slate-200 shadow-sm">
          <div class="text-center pr-4 border-r border-slate-100">
            <span class="block text-xs text-slate-400">รีวิวทั้งหมด</span>
            <span class="text-lg font-bold text-indigo-600"><%= totalRated %> เล่ม</span>
          </div>
          <div class="text-center">
            <span class="block text-xs text-slate-400">คะแนนเฉลี่ยที่ให้</span>
            <span class="text-lg font-bold text-amber-500">★ <%= avgGiven %></span>
          </div>
        </div>
      <% } %>
    </div>

    <!-- รายการหนังสือที่รีวิวแล้ว -->
    <% if (ratedBooks.length === 0) { %>
      <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center">
        <div class="text-4xl mb-3">📚</div>
        <h2 class="text-lg font-semibold text-slate-800 mb-1">คุณยังไม่ได้รีวิวหนังสือเล่มไหนเลย</h2>
        <p class="text-sm text-slate-500 mb-6">ลองเลือกหนังสือที่คุณอ่านจบแล้ว และแชร์ความคิดเห็นให้เพื่อนๆ รู้กัน!</p>
        <a href="/" class="inline-block px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-xl transition">
          ไปเลือกดูหนังสือหน้าแรก
        </a>
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% ratedBooks.forEach(item => { %>
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 flex flex-col sm:flex-row gap-5 transition hover:border-indigo-200">
            
            <!-- รูปปกหนังสือ (คลิกไปหน้า book ได้) -->
            <a href="/books/<%= item.book_id %>" class="w-24 sm:w-28 flex-shrink-0 mx-auto sm:mx-0">
              <img 
                src="<%= item.cover_image || 'https://via.placeholder.com/300x450?text=No+Cover' %>" 
                alt="<%= item.title %>" 
                class="w-full h-36 sm:h-40 object-cover rounded-xl shadow-sm hover:opacity-90 transition"
              >
            </a>

            <!-- รายละเอียดรีวิว -->
            <div class="flex-grow flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-start justify-between gap-2 mb-1">
                  <div>
                    <span class="text-xs font-medium text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full">
                      <%= item.genre || 'ทั่วไป' %>
                    </span>
                    <a href="/books/<%= item.book_id %>" class="block text-lg font-bold text-slate-900 hover:text-indigo-600 mt-1 transition">
                      <%= item.title %>
                    </a>
                  </div>

                  <!-- วันที่รีวิว -->
                  <span class="text-xs text-slate-400">
                    รีวิวเมื่อ <%= new Date(item.created_at).toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                  </span>
                </div>

                <!-- ดาวที่ให้ -->
                <div class="flex items-center gap-1 my-2">
                  <% for (let i = 1; i <= 5; i++) { %>
                    <span class="text-lg <%= i <= item.rating ? 'text-amber-400' : 'text-slate-200' %>">★</span>
                  <% } %>
                  <span class="text-xs font-semibold text-slate-500 ml-1">(<%= item.rating %>/5)</span>
                </div>

                <!-- ข้อความรีวิว -->
                <p class="text-slate-600 text-sm bg-slate-50 p-3.5 rounded-xl border border-slate-100 leading-relaxed whitespace-pre-line">
                  "<%= item.comment %>"
                </p>
              </div>

              <!-- ปุ่มจัดการ (แก้ไข / ลบรีวิว) -->
              <div class="flex items-center justify-end gap-3 mt-4 pt-3 border-t border-slate-100">
                <a 
                  href="/books/<%= item.book_id %>" 
                  class="px-4 py-1.5 text-xs font-medium text-indigo-600 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition"
                >
                  ✎ แก้ไขรีวิว
                </a>

                <form action="/rated-books/delete/<%= item.review_id %>" method="POST" onsubmit="return confirm('ต้องการลบรีวิวของหนังสือเล่มนี้ใช่หรือไม่?');">
                  <button 
                    type="submit" 
                    class="px-4 py-1.5 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded-lg transition"
                  >
                    ลบรีวิว
                  </button>
                </form>
              </div>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>

  </main>

</body>
</html>