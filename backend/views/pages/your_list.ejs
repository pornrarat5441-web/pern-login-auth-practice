<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your List - รายการหนังสือของฉัน</title>
  <link rel="stylesheet" href="/css/output.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- Navbar -->
  <%- include('../partials/navbar', { user }) %>

  <!-- Main Content -->
  <main class="max-w-5xl mx-auto px-4 py-8 flex-grow w-full">

    <!-- Header & สรุปความคืบหน้าภาพรวม -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold text-slate-900">Your List</h1>
        <p class="text-sm text-slate-500 mt-1">จัดการรายการหนังสือและบันทึกความคืบหน้าการอ่านของคุณ</p>
      </div>

      <% if (userBooks.length > 0) { %>
        <% 
          const totalBooks = userBooks.length;
          const completedBooks = userBooks.filter(b => b.current_page >= b.total_pages).length;
        %>
        <div class="flex items-center gap-4 bg-white px-5 py-3 rounded-2xl border border-slate-200 shadow-sm">
          <div class="text-center pr-4 border-r border-slate-100">
            <span class="block text-xs text-slate-400">ในลิสต์ทั้งหมด</span>
            <span class="text-lg font-bold text-indigo-600"><%= totalBooks %> เล่ม</span>
          </div>
          <div class="text-center">
            <span class="block text-xs text-slate-400">อ่านจบแล้ว</span>
            <span class="text-lg font-bold text-emerald-600"><%= completedBooks %> เล่ม</span>
          </div>
        </div>
      <% } %>
    </div>

    <!-- รายการหนังสือในลิสต์ -->
    <% if (userBooks.length === 0) { %>
      <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center">
        <div class="text-4xl mb-3">🔖</div>
        <h2 class="text-lg font-semibold text-slate-800 mb-1">ยังไม่มีหนังสือใน Your List</h2>
        <p class="text-sm text-slate-500 mb-6">กดเพิ่มหนังสือที่สนใจจากหน้าแรกหรือหน้ารายละเอียดหนังสือ เพื่อเริ่มบันทึกการอ่านได้เลย</p>
        <a href="/" class="inline-block px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-xl transition">
          ไปเลือกหนังสือหน้าแรก
        </a>
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% userBooks.forEach(item => { %>
          <% 
            // คำนวณเปอร์เซ็นต์การอ่าน (ไม่เกิน 100%)
            const percent = Math.min(100, Math.round((item.current_page / item.total_pages) * 100));
            const isCompleted = percent === 100;
          %>

          <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 flex flex-col sm:flex-row gap-5 transition hover:border-indigo-200">
            
            <!-- รูปปกหนังสือ -->
            <a href="/books/<%= item.book_id %>" class="w-24 sm:w-28 flex-shrink-0 mx-auto sm:mx-0">
              <img 
                src="<%= item.cover_image || 'https://via.placeholder.com/300x450?text=No+Cover' %>" 
                alt="<%= item.title %>" 
                class="w-full h-36 sm:h-40 object-cover rounded-xl shadow-sm hover:opacity-90 transition"
              >
            </a>

            <!-- ข้อมูลและฟอร์มอัปเดตหน้า -->
            <div class="flex-grow flex flex-col justify-between">
              <div>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
                  <span class="text-xs font-medium text-indigo-600 bg-indigo-50 px-2.5 py-0.5 rounded-full">
                    <%= item.genre || 'ทั่วไป' %>
                  </span>

                  <!-- Badge สถานะการอ่าน -->
                  <% if (isCompleted) { %>
                    <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full">
                      ✓ อ่านจบแล้ว
                    </span>
                  <% } else if (item.current_page > 0) { %>
                    <span class="text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full">
                      กำลังอ่าน
                    </span>
                  <% } else { %>
                    <span class="text-xs font-medium text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-full">
                      ยังไม่ได้เริ่มอ่าน
                    </span>
                  <% } %>
                </div>

                <a href="/books/<%= item.book_id %>" class="block text-lg font-bold text-slate-900 hover:text-indigo-600 mt-1 transition">
                  <%= item.title %>
                </a>

                <!-- แถบ Progress Bar -->
                <div class="mt-4">
                  <div class="flex justify-between text-xs font-medium mb-1.5">
                    <span class="text-slate-600">
                      อ่านไปแล้ว <strong class="text-slate-900"><%= item.current_page %></strong> / <%= item.total_pages %> หน้า
                    </span>
                    <span class="<%= isCompleted ? 'text-emerald-600 font-bold' : 'text-indigo-600 font-bold' %>">
                      <%= percent %>%
                    </span>
                  </div>
                  <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                    <div 
                      class="h-2.5 rounded-full transition-all duration-300 <%= isCompleted ? 'bg-emerald-500' : 'bg-indigo-600' %>" 
                      style="width: <%= percent %>%"
                    ></div>
                  </div>
                </div>
              </div>

              <!-- ฟอร์มกรอกเลขหน้า + ปุ่มลบออกจากลิสต์ -->
              <div class="flex flex-wrap items-center justify-between gap-3 mt-4 pt-3 border-t border-slate-100">
                
                <!-- อัปเดตหน้าปัจจุบัน -->
                <form action="/your-list/update/<%= item.book_id %>" method="POST" class="flex items-center gap-2">
                  <label for="page-<%= item.book_id %>" class="text-xs font-medium text-slate-600">หน้าที่อ่านถึง:</label>
                  <input 
                    id="page-<%= item.book_id %>"
                    type="number" 
                    name="current_page" 
                    value="<%= item.current_page %>" 
                    min="0" 
                    max="<%= item.total_pages %>" 
                    class="w-20 px-2.5 py-1.5 text-sm border border-slate-300 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none text-center"
                    required
                  >
                  <button 
                    type="submit" 
                    class="px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium rounded-lg transition shadow-sm"
                  >
                    อัปเดต
                  </button>
                </form>

                <!-- ปุ่มไปรีวิว (โชว์เมื่ออ่านจบ) + ปุ่มลบออก -->
                <div class="flex items-center gap-2">
                  <% if (isCompleted) { %>
                    <a 
                      href="/books/<%= item.book_id %>" 
                      class="px-3 py-1.5 text-xs font-medium text-amber-700 bg-amber-50 hover:bg-amber-100 rounded-lg transition"
                    >
                      ★ เขียนรีวิว
                    </a>
                  <% } %>

                  <form action="/your-list/remove/<%= item.book_id %>" method="POST" onsubmit="return confirm('ต้องการลบหนังสือเล่มนี้ออกจาก Your List ใช่หรือไม่?');">
                    <button 
                      type="submit" 
                      class="px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded-lg transition"
                    >
                      ลบออก
                    </button>
                  </form>
                </div>

              </div>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>

  </main>
  <%- include('../partials/footer') %>

</body>
</html>